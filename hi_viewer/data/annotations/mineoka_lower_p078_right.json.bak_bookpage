  {
    "id": "anno-mineoka_lower_p078_right-05",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "卒族　六十二戸　人口三百二十五人"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "卒族（そつぞく）六十二戸　人口三百二十五人"
      },
      {
        "purpose": "english_translation",
        "value": "Sotsu (lower retainers): 62 households, population 325. Continues the 外ニ group begun at 士族. NOTE: the printed male/female sub-counts (159 + 66) sum to only 225, one hundred short of this stated 325 — a source-level defect, verified at 12x (the total's 三 resolves into three distinct stroke-rows, and the 女 run is one glyph shorter than the 男 run, i.e. it lacks a 百). The intended female figure was almost certainly 百六十六人 (325 − 159 = 166)."
      },
      {
        "purpose": "identifying",
        "value": "卒族"
      }
    ],
    "target": {
      "source": "images/lower_p078_right.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
        "value": "xywh=pixel:1872,1182,92,1341"
      }
    }
  },
  {
