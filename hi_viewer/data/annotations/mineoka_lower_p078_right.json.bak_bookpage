[
  {
    "id": "anno-mineoka_lower_p078_right-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "藩制一覽表第七（三草）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "藩制一覧表（はんせいいちらん）第七（三草）"
      },
      {
        "purpose": "english_translation",
        "value": "Running head: Hansei Ichiran, Fascicle 7 — (Mikusa). The printer's provenance line, naming the domain the leaf is filed under. It names Mikusa even though all seven data columns to its left, as far as the ○三草藩 marker, still belong to Mineoka. Provenance, not an attribution of the data."
      },
      {
        "purpose": "identifying",
        "value": "藩制一覧表第七（三草）"
      }
    ],
    "target": {
      "source": "images/lower_p078_right.jpg",
