  {
    "id": "anno-toyotsu_upper_p053_left-11",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "一高五千石"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "一、高 五千石"
      },
      {
        "purpose": "english_translation",
        "value": "Item: an assessment of 5,000 koku. This is the base against which the imperial reward grant (御賞典) is reckoned. The facing page (book p. 80) enters the same item as 一五千石　御賞典米, and the red-ink block lower on this page takes two and a half tenths of it to give the 1,250-koku grant, so the figure is confirmed on both sides of the spread."
      },
      {
        "purpose": "identifying",
        "value": "一高五千石"
      }
    ],
    "target": {
      "source": "images/upper_p053_left.jpg",
