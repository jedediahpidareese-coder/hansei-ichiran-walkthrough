  },
  {
    "id": "anno-toyotsu_upper_p053_left-12",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "但シ御賞典歩合被仰出候上本文入候心得"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "但し、御賞典の歩合仰せ出され候上は、本文へ入れ候心得"
      },
      {
        "purpose": "english_translation",
        "value": "\"Note: once the proportion of the imperial reward grant has been decreed, this amount is to be understood as entered into the main text.\" A procedural caveat: the 5,000-koku item was still provisional when the return was filed."
      },
      {
        "purpose": "identifying",
        "value": "但シ御賞典歩合註記"
      }
    ],
