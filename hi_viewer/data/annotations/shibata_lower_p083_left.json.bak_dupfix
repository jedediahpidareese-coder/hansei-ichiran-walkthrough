[
  {
    "id": "anno-shibata_lower_p083_left-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "非人戸數 十三軒"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "非人戸数（ひにんこすう） 十三軒"
      },
      {
        "purpose": "english_translation",
        "value": "Hinin (outcast) households: 13. This is the RIGHTMOST column on the page and so is read first; sitting to the right of the ○島原藩 marker, it belongs to the preceding domain, 新發田藩 (Shibata). The 十 is a plain cross, not 千."
      },
      {
        "purpose": "identifying",
        "value": "非人戸數"
      }
    ],
    "target": {
      "source": "images/lower_p083_left.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
        "value": "xywh=pixel:2611,1010,88,668"
      }
    }
  },
  {
