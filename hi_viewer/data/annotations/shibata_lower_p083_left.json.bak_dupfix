    "body": [
      {
        "purpose": "transcribing",
        "value": "人員 九十七人 内"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "人員（じんいん） 九十七人 内（うち）"
      },
      {
        "purpose": "english_translation",
        "value": "Population of the hinin households: 97 persons. The 内 ('of which') closing this centred run introduces the male/female breakdown printed in two half-width runs directly below. Arithmetic check: 51 male + 46 female = 97 ✓. At 7.5 people per household the ratio is high, but that is what the source prints."
      },
      {
        "purpose": "identifying",
        "value": "人員 (非人)"
      }
    ],
    "target": {
      "source": "images/lower_p083_left.jpg",
