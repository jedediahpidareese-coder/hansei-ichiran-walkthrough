  {
    "id": "anno-tsuruga_upper_p216_left-04",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "込"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "込"
      },
      {
        "purpose": "english_translation",
        "value": "A single hand-inked mark standing alone in the otherwise empty column slot between the 合高 and 正税 columns. Its stroke structure matches the printed 込 of 込高 (the 辶 cluster at upper left, 入 as the chevron at upper right, and the long sweeping base), but it is 94 px wide against a 68 px type body and its stroke ends are rounded, so it is written by hand rather than printed. Probable reading, not certain."
      },
      {
        "purpose": "identifying",
        "value": "欄間手書記号"
      }
    ],
