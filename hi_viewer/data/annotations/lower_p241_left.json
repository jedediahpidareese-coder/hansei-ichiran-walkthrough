    "body": [
      {
        "purpose": "transcribing",
        "value": "藩制一覽表第九（宍戸、七戸）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "藩制一覧表 第九（宍戸・七戸）"
      },
      {
        "purpose": "english_translation",
        "value": "Running header in the outer margin: Table of Domain Institutions, Fascicle 9 (Shishido, Shichinohe). Fascicle 9 is the officials-and-military register. Provenance only — it names the two domains whose entries open on this leaf and says nothing about Shizuku, whose four closing columns stand on the right."
      },
      {
        "purpose": "identifying",
        "value": "柱藩制一覽表第九（宍戸、七戸）"
      }
    ],
    "target": {
