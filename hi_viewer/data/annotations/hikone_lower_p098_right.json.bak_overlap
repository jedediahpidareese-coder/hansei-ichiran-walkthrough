  },
  {
    "id": "anno-hikone_lower_p098_right-06",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "金二千二百四十八兩壹分貳朱永五十九文三分二厘六毛"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "きん にせんにひゃくよんじゅうはちりょう いちぶ にしゅ えい ごじゅうきゅうもん さんぶ にりん ろくもう（約2,248.25両）"
      },
      {
        "purpose": "english_translation",
        "value": "Regular land tax in gold: 2,248 ryō 1 bu 2 shu, plus copper-cash (ei) 59 mon 3 bu 2 rin 6 mō (≈2,248.25 ryō)."
      },
      {
        "purpose": "identifying",
        "value": "正租金"
