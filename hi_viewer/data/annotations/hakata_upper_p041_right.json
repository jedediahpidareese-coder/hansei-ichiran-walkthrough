    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "（此米五石四斗三升六合三勺）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "（此の米　五石四斗三升六合三勺）"
      },
      {
        "purpose": "english_translation",
        "value": "\"This in rice\": the gold tax above converted to rice, 5.4363 koku. The conversion closes exactly at the eight-ryō-per-koku rate that Hachinohe's entry prints explicitly two half-leaves earlier (upper_p040_right) — 43.4375 ryō of gold plus 53.18 mon of ei-cash makes 43.49068 ryō, and 43.49068 divided by 8 is 5.4363."
      },
      {
        "purpose": "identifying",
        "value": "伯太雜税金此米"
      }
    ],
    "target": {
      "source": "images/upper_p041_right.jpg",
