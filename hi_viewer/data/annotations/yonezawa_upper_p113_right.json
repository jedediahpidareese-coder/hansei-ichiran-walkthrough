  {
    "id": "anno-yonezawa_upper_p113_right-15",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "（河原之者百十七戸　人員六百六十五人　内　男三百四十一人　女三百二十四人）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "（河原の者 百十七戸、人員 六百六十五人、内 男 三百四十一人・女 三百二十四人）"
      },
      {
        "purpose": "english_translation",
        "value": "Bracketed annotation: \"The kawaramono (riverbank people): 117 households; population 665 persons, of whom 341 male and 324 female.\" The 665 and the 341/324 split are identical to the eta/hinin entry printed to the right, so this note restates that entry and adds the household count. The third glyph is 之, not ニ."
      },
      {
        "purpose": "identifying",
        "value": "河原之者註記"
      }
