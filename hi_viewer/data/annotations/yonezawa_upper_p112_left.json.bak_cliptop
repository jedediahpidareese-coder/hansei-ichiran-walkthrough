  {
    "id": "anno-yonezawa_upper_p112_left-24",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "內"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "内（うち）"
      },
      {
        "purpose": "english_translation",
        "value": "\"Of which\" — the second 內 sub-heading on the page, heading the population (人員) breakdown into the shizoku-population (士族人口) and sotsu-population (卒族人口) totals with their male/female splits. Distinct from the earlier 內 (box 06, x=2020) which heads the household (戸數) breakdown. Measured ink bbox of the isolated glyph = x1362-1417, y1219-1280 (56x62); the proposed rect pads this correctly and does not overlap 士族人口 (ends x=1292) or 人員 (starts x=1433). Arithmetic under both sub-breakdowns reconciles exactly: shizoku pop 15,801 = 7,565 male + 8,236 female; sotsu pop 22,438 = 11,980 male + 10,458 female."
      },
      {
        "purpose": "identifying",
        "value": "內人口内訳"
      }
    ],
    "target": {
      "source": "images/upper_p112_left.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
        "value": "xywh=pixel:1352,1209,75,81"
      }
    }
  }
]