[
  {
    "id": "anno-asahiyama_lower_p027_left-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "此俵四萬三千百貳拾六俵七升四合四勺七才三斗七升五合入"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "此俵（このひょう）四万三千百二十六俵七升四合四勺七才、三斗七升五合入（り）"
      },
      {
        "purpose": "english_translation",
        "value": "Rice expressed in bales (kono-hyō): 43,126 bales plus a 0.07447-koku remainder, reckoned at 3 to 7 sho 5 go (=0.375 koku) per bale — the standard HI koku-per-bale fill rate. Printed as a two-column interlinear (warichu) note at the top-right; it converts a koku total carried over from the preceding page. The bracketed 三斗七升五合入 states the fill rate, not a separate quantity."
      },
      {
        "purpose": "identifying",
        "value": "此俵"
      }
    ],
    "target": {
      "source": "images/lower_p027_left.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
