[
  {
    "id": "anno-funai_lower_p215_left-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "（大括弧上罫）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "（大括弧の上罫）"
      },
      {
        "purpose": "english_translation",
        "value": "Upper rule of a large brace. It runs the width of the two columns below it and hooks downward at its LEFT end; the matching lower rule hooks upward at the same end. The pair closes a brace that opens on the facing leaf lower_p215_right, where I found the same two rules hooking at their RIGHT ends around the 步兵 column. The brace therefore groups the three arms whose strength Fukuyama gives in reckoned forty-eight-man platoons: infantry on the recto, artillery and recruited standing troops here."
      },
      {
        "purpose": "identifying",
        "value": "福山兵隊括弧上罫"
      }
    ],
    "target": {
      "source": "images/lower_p215_left.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
        "value": "xywh=pixel:2432,1032,280,43"
      }
    }
  },
  {
