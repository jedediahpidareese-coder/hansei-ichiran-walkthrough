  {
    "id": "anno-kano_upper_p097_left-25",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "右惣戸數　六千三百五軒"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "右総戸数　六千三百五軒"
      },
      {
        "purpose": "english_translation",
        "value": "Total of the households listed above: 6,305. The column starts noticeably higher than the status columns beside it, which marks it as a summary line rather than another status entry. I read the peasant figure on the facing leaf myself at high magnification and it is 五千三百八拾七軒, 5,387; adding the 681 townsman, 15 shrine-priest, 173 temple, 4 eta and 48 hinin households printed here gives 6,308, three more than the figure the source prints. The source gives no account of the difference. The 317 shizoku and 71 sotsu households on the facing leaf fall outside this total, since including them would put it 391 over."
      },
      {
        "purpose": "identifying",
        "value": "右惣戸數"
      }
    ],
    "target": {
      "source": "images/upper_p097_left.jpg",
      "selector": {
