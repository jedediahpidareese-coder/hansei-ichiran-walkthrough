[
  {
    "id": "anno-kururi_upper_p188_left-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "永　二千百六拾七貫十七文　五ヶ年平均"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "永（えい）二千百六十七貫十七文　五ヶ年平均"
      },
      {
        "purpose": "english_translation",
        "value": "Eiraku cash: 2,167 kan 17 mon, stated as a five-year average (the small type at the foot of the column reads 五ヶ年平均). This is the domain's total tax receipt expressed in eiraku-denominated cash; the gloss two columns to the left states that this eiraku figure is the sum of all the various taxes. The column immediately to the left converts it to rice at eight ryo to the koku, and the conversion checks out exactly: 2,167.017 divided by 8 is 270.8771, which that column prints as 270.877 koku."
      },
      {
        "purpose": "identifying",
        "value": "永"
      }
    ],
    "target": {
      "source": "images/upper_p188_left.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
        "value": "xywh=pixel:2587,1064,121,1427"
      }
    }
  },
  {
