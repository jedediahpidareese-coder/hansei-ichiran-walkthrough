[
  {
    "id": "anno-asada_lower_p225_right-00",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "藩制一覽表第九（麻田）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "藩制一覧表第九（麻田）（はんせいいちらんひょう だいきゅう・あさだ）"
      },
      {
        "purpose": "english_translation",
        "value": "Running head: Table of Domain Systems, fascicle 9 (Asada). This line is provenance, naming the fascicle and the domain whose block the leaf belongs to. It can name a different domain from part of the data printed on the page, as it does here, where the three right-hand columns still carry Annaka's material."
      },
      {
        "purpose": "identifying",
        "value": "柱書藩制一覽表第九"
      }
    ],
    "target": {
      "source": "images/lower_p225_right.jpg",
      "selector": {
        "type": "FragmentSelector",
        "conformsTo": "http://www.w3.org/TR/media-frags/",
        "value": "xywh=pixel:2150,1228,72,588"
      }
    }
  },
  {
    "id": "anno-asada_lower_p225_right-01",
    "type": "Annotation",
    "body": [
      {
        "purpose": "transcribing",
        "value": "少參事　貳員（以下名姓不詳）"
      },
      {
        "purpose": "modern_jp_reading",
        "value": "少参事　二員（以下名姓不詳）（しょうさんじ にいん・いか めいせい ふしょう）"
      },
      {
        "purpose": "english_translation",
        "value": "Junior councillors: two members. The parenthesised note, set as a two-sub-column warichu (right sub-column 以下名姓, left sub-column 不詳), records that the given names and surnames of the officials listed from here on are not known. This column stands to the right of the ○麻田藩 marker, so it belongs to Annaka Domain, and it explains why Annaka's name register is empty on this leaf."
      },
      {
        "purpose": "identifying",
        "value": "安中藩少參事"
      }
    ],
    "target": {
      "source": "images/lower_p225_right.jpg",
