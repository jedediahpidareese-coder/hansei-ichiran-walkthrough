      },
      {
        "purpose": "modern_jp_reading",
        "value": "権少参事　四員（ごんしょうさんじ よんいん）"
      },
      {
        "purpose": "english_translation",
        "value": "Acting junior councillors: four members. Also to the right of the ○麻田藩 marker, so this belongs to Annaka Domain. No names are given, the preceding note having declared them unknown."
      },
      {
        "purpose": "identifying",
        "value": "安中藩權少參事"
      }
